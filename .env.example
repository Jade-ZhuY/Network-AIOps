# 默认 mock 模型/业务数据；持久会话需要单独配置 PostgreSQL。
ENVIRONMENT=development
LLM_MODE=mock
DATA_BACKEND=mock
EMBEDDING_MODE=mock
DEMO_NOW=2026-10-11T09:00:00Z
DEFAULT_TIMEZONE=Asia/Shanghai
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=replace-with-served-model-id
LLM_API_KEY=EMPTY
LLM_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=35
AGENT_RECURSION_LIMIT=16
# Agentic Report is enabled for the pure RAG route; SQL/both keep their existing report contract.
REPORT_MAX_SEARCHES=2
REPORT_MAX_SOURCE_READS=4
REPORT_MAX_REVISIONS=1
REPORT_MAX_SOURCES=8
REPORT_CONTEXT_TOKENS=10000
REPORT_TIMEOUT_SECONDS=120
LLM_REASONING_EFFORT=
PERSISTENCE_BACKEND=none
CHECKPOINT_POSTGRES_URI=
API_AUTH_TOKEN=
API_ADMIN_TOKEN=
ENABLE_DEMO_API=true
RETENTION_DAYS=30
REQUEST_TIMEOUT_SECONDS=180
MAX_CONCURRENT_REQUESTS=4
UPLOAD_MAX_BYTES=10485760
# DATA_BACKEND=mysql 时才使用；仅限业务库 SELECT 视图账号。
MYSQL_READONLY_URI=
# Parent Documents always use a separate MySQL table writer; no memory/file fallback.
# mysql+pymysql://USER:TOKEN@HOST:PORT/DATABASE?charset=utf8mb4
RAG_PARENT_MYSQL_URI=
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=3000
TEXT_TO_SQL_ENABLED=true
RAG_TOP_K=8
RAG_RERANK_TOP_K=4
# LangChain heading hierarchy -> parent windows -> child windows (token budgets).
RAG_PARENT_CHUNK_SIZE=1200
RAG_PARENT_CHUNK_OVERLAP=200
RAG_CHILD_CHUNK_SIZE=300
RAG_CHILD_CHUNK_OVERLAP=50
RAG_TOKEN_ENCODING=cl100k_base
# EMBEDDING_MODE=openai 时填写真实服务。
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=EMPTY
# 每个 Embedding 请求的文本数量，与文档切块的字符长度不同。
EMBEDDING_BATCH_SIZE=32
# memory 仅在内存中保存子块向量；milvus 持久化子块向量。父块始终使用 MySQL。
RAG_VECTOR_BACKEND=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=network_aiops_chunks_hybrid
MILVUS_DIMENSION=1024
MILVUS_TIMEOUT_SECONDS=15
# Native BM25 sparse inverted index; changing these requires a new collection.
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75
# Document parsing uses remote MinerU only; no pypdf fallback.
# MD/TXT are wrapped as HTML and parsed by MinerU Flash; PDF/images use MINERU_TIER.
MINERU_API_URL=http://127.0.0.1:18000
MINERU_API_KEY=
MINERU_API_KEY_FILE=.env.mineru-cloud
MINERU_EXPECTED_VERSION=4.0.12
MINERU_TIER=standard
MINERU_OCR_MODE=auto
MINERU_PARSE_TIMEOUT_SECONDS=900
MINERU_POLL_INTERVAL_SECONDS=2
