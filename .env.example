# 默认 mock 模型/业务数据；持久会话需要单独配置 PostgreSQL。
ENVIRONMENT=development
LLM_MODE=mock
DATA_BACKEND=mock
EMBEDDING_MODE=mock
DEMO_NOW=2026-10-11T09:00:00Z
DEFAULT_TIMEZONE=Asia/Shanghai
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=replace-with-served-model-id
LLM_API_KEY=EMPTY
LLM_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=35
AGENT_RECURSION_LIMIT=16
LLM_REASONING_EFFORT=
PERSISTENCE_BACKEND=none
CHECKPOINT_POSTGRES_URI=
API_AUTH_TOKEN=
API_ADMIN_TOKEN=
ENABLE_DEMO_API=true
RETENTION_DAYS=30
REQUEST_TIMEOUT_SECONDS=180
# Docker 使用既有宿主机 PostgreSQL；默认为 mock LLM/SQL，避免意外远程调用。
DOCKER_LLM_MODE=mock
DOCKER_DATA_BACKEND=mock
# DATA_BACKEND=mysql 时才使用；仅限业务库 SELECT 视图账号。
MYSQL_READONLY_URI=
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=3000
RAG_TOP_K=8
RAG_RERANK_TOP_K=4
# EMBEDDING_MODE=openai 时填写真实服务；索引仍只存在内存。
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=EMPTY
