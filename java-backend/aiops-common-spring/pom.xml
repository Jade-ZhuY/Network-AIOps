<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.networkaiops</groupId>
    <artifactId>aiops-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>aiops-common-spring</artifactId>
  <name>Network AIOps common-spring</name>
  <description>Reusable authentication, JSON constraints and HTTP error handling.</description>
  <dependencies>
    <dependency>
      <groupId>com.networkaiops</groupId>
      <artifactId>aiops-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>module-boundaries</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.networkaiops:*</exclude>
                    <exclude>org.springframework:spring-jdbc</exclude>
                    <exclude>org.flywaydb:*</exclude>
                    <exclude>com.h2database:*</exclude>
                  </excludes>
                  <includes>
                    <include>com.networkaiops:aiops-common-core</include>
                  </includes>
                  <message>Module dependency boundary violated. See docs/java-multimodule-architecture.md.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
